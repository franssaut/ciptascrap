{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/sync/status", "destination": "/api/status" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/sync", "destination": "/api/sync" }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 */6 * * *"
    }
  ]
}
